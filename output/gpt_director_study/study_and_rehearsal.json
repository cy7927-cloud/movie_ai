  "study_cases": [
    {
      "id": "CASE_A",
      "title": "暗处的人、红衣队列与黑猫：信息先于因果",
      "time_window": "595–616",
      "narrative_core": "在不同可见地点/人物之间交织镜头；黑猫位于信息链中央，但人物是否看见它尚无证据",
      "observations": [
        {
          "second": 595.0,
          "visible": "幽暗通道尽头有暖色光及人影"
        },
        {
          "second": 597.2,
          "visible": "黑衣男子靠在暗色装饰门边"
        },
        {
          "second": 600.2,
          "visible": "数名红衣人物面向石树及建筑"
        },
        {
          "second": 603.9,
          "visible": "红衣人物仰头，前后错开站位"
        },
        {
          "second": 604.4,
          "visible": "黑猫独立站在暖色栏杆上"
        },
        {
          "second": 607.8,
          "visible": "黑衣男子从门边向外窥看"
        },
        {
          "second": 611.2,
          "visible": "远处石廊入口见暖色灯笼和人影"
        },
        {
          "second": 614.0,
          "visible": "黑衣男子重新出现在暗色装饰门旁"
        }
      ],
      "hypotheses": [
        {
          "claim": "猫的单独镜头可能将观众注意力转向一项新的信息",
          "rationale": "红衣人群→黑猫→暗处男子的切换，使观众在同一小段落中比较至少三类对象",
          "alternative": "猫只是独立悬疑意象，既不是任何人视线的目标，也可能不是同一空间",
          "verification": "必须复看前后声音/对白、人物视线方向、猫与人物能否处于同一空间"
        },
        {
          "claim": "暗色人物在猫之前与之后出现，可能构成跨地点的平行观察/等待结构",
          "rationale": "597、608、614秒附近均可见相似门边黑衣人物，其间交错进入红衣队列、猫、石廊",
          "alternative": "相似服装未证实同一演员；多个地点的剪辑也可能只是连续事件信息",
          "verification": "核实人物身份、台词及空间地理关系，确认各时刻是否真为同一行动"
        },
        {
          "claim": "色温、明暗和环境尺度的交替可以成为悬念节奏的一部分",
          "rationale": "暖色栏杆/红衣外景与冷暗门边/石洞交替，观众阅读画面的成本和注意目标改变",
          "alternative": "色差仅来自不同空间的自然照明，不一定具有情绪象征",
          "verification": "结合整段声音、导演场面语境和人物目标，排除纯粹空间交代"
        }
      ],
      "unverified": [
        "对白和音乐关系",
        "猫和男人的真实视线关系",
        "片中同一空间/时间",
        "导演真实意图"
      ],
      "avoid_claims": [
        "不能将猫镜头解释为角色必然看见猫",
        "不能将正常跨景切换当作摄影失误",
        "不能把自动镜头候选当成精确切点"
      ],
      "transferable_craft": "把一项线索暂时交给观众、暂不交给角色；用前后可辨的空间锚点让人物/意象之间形成张力，同时保留对因果的审慎。"
    },
